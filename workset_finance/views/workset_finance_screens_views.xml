<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Екран «Власник» (круг 2; макет A + таблиця «Драбина» макета B під ним): client action OWL (static/src/js/finance_screens.js), один
         виклик сервера finance_owner (models/workset_finance_screens.py). path — постійна адреса сторінки (/odoo/workset-finance-owner):
         посилання не залежить від номера дії в базі. Бачить лише група «Власник» — меню й метод сервера (_check_screen); місяць — у params дії
         (з посилання «Прибутковість ліній» і назад), без нього — за замовчуванням сервера -->
    <record id="action_owner" model="ir.actions.client">
        <field name="name">Власник</field>
        <field name="tag">workset_finance.owner</field>
        <field name="path">workset-finance-owner</field>
    </record>

    <!-- Круг 3б (правило власника 07.11: колонка «№» у кожному списку): клік екрана, що відкриває стандартну модель, — свій список від
         штатного (mode primary) з першою колонкою «№» (віджет static/src/js/row_number.js); решта — як у штатному. priority 99: штатний
         список моделі (priority 10–16) лишається видом за замовчуванням — цей лише за посиланням із кліку ('views' в описі сервера,
         CLICK_VIEWS у models/workset_finance_screens.py). Рядки виписки (account.bank.statement.line) — без свого виду: у community Odoo 19
         штатного списку для них немає (він у account_accountant, поза залежностями модуля) -->
    <record id="view_click_move_line_list" model="ir.ui.view">
        <field name="name">workset.finance.click.account.move.line.list</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_tree"/>
        <field name="mode">primary</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//list/field[1]" position="before">
                <field name="id" string="№" widget="workset_finance_row_number" readonly="1" width="50px"/>
            </xpath>
        </field>
    </record>

    <record id="view_click_analytic_line_list" model="ir.ui.view">
        <field name="name">workset.finance.click.account.analytic.line.list</field>
        <field name="model">account.analytic.line</field>
        <field name="inherit_id" ref="analytic.view_account_analytic_line_tree"/>
        <field name="mode">primary</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//list/field[1]" position="before">
                <field name="id" string="№" widget="workset_finance_row_number" readonly="1" width="50px"/>
            </xpath>
        </field>
    </record>

    <!-- рахунки клієнтів («Не оплачено»): від штатного списку рахунків клієнтів; клік передає default_move_type, як меню «Рахунки» Odoo —
         тоді видно колонки «Клієнт» і «Дата рахунку» -->
    <record id="view_click_move_list" model="ir.ui.view">
        <field name="name">workset.finance.click.account.move.list</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="mode">primary</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//list/field[1]" position="before">
                <field name="id" string="№" widget="workset_finance_row_number" readonly="1" width="50px"/>
            </xpath>
        </field>
    </record>
</odoo>
