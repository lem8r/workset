<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Смарт-кнопка «Умови» на формі контакту — лише замовнику (є в «Замовниках» лінії або має діючі ставки) і лише групі «Перегляд»;
         веде на екран «Умови клієнта» комерційного контрагента. Лише додавання в button_box (xpath за name) -->
    <record id="view_partner_form_client" model="ir.ui.view">
        <field name="name">res.partner.form.workset.client</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="priority">2010</field>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_workset_client_card" type="object" class="oe_stat_button" icon="fa-handshake-o"
                        invisible="not workset_client_is_customer" groups="workset_client.group_viewer">
                    <field name="workset_client_is_customer" invisible="1"/>
                    <div class="o_stat_info">
                        <span class="o_stat_text">Умови</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>

    <!-- «Умови клієнтів»: замовники з «Замовників» ліній або з діючими ставками; рядок відкриває екран «Умови клієнта» (js_class —
         static/src/js/client_card.js), не форму контакту. Без «Створити», правки й видалення: умови правлять в екрані й у джерелах.
         Чого бракує — одна колонка «Бракує» жовтим («договір, термін, перевірка»), усе є — порожньо; фільтри по кожній ознаці лишились -->
    <record id="view_partner_client_list" model="ir.ui.view">
        <field name="name">res.partner.list.workset.client</field>
        <field name="model">res.partner</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <list string="Умови клієнтів" js_class="workset_client_list" create="0" edit="0" delete="0" default_order="name">
                <field name="workset_client_has_line" column_invisible="1"/>
                <!-- «№» — номер рядка на екрані: переносний віджет «Прибутковості» 19.0.6 (workset_profit/static/src/js/row_number.js), серим -->
                <field name="id" string="№" widget="workset_profit_row_number" readonly="1" width="50px"/>
                <field name="name" string="Замовник" width="280px"/>
                <field name="workset_client_line_text" string="Лінія" width="170px" decoration-muted="not workset_client_has_line"/>
                <field name="workset_client_rate_count" string="Ставок діє" width="100px"/>
                <field name="workset_client_share_avg" string="Частка, сер." width="110px"/>
                <field name="workset_client_housing_text" string="Житло — хто платить"/>
                <!-- К1г: одна колонка замість «Договір», «Термін оплати», «Перевірено»; усе є — порожня клітинка -->
                <field name="workset_client_missing_text" string="Бракує" width="260px" decoration-warning="workset_client_missing_text"/>
            </list>
        </field>
    </record>

    <record id="view_partner_client_search" model="ir.ui.view">
        <field name="name">res.partner.search.workset.client</field>
        <field name="model">res.partner</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <search string="Умови клієнтів">
                <field name="name" string="Замовник"/>
                <!-- окремими групами: обрані разом — «і», не «або» -->
                <filter name="no_contract" string="Без договору"
                        domain="[('workset_client_contract_no', '=', False), ('workset_client_contract_scan_ids', '=', False)]"/>
                <separator/>
                <filter name="no_term" string="Без терміну оплати" domain="[('workset_client_has_term', '=', False)]"/>
                <separator/>
                <filter name="not_checked" string="Не перевірено" domain="[('workset_client_checked_date', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_clients" model="ir.actions.act_window">
        <field name="name">Умови клієнтів</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_partner_client_list"/>
        <field name="search_view_id" ref="view_partner_client_search"/>
        <field name="domain">[('workset_client_is_customer', '=', True)]</field>
        <field name="context">{'create': False}</field>
        <field name="path">workset-clients</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Замовників ще немає</p>
            <p>Тут — замовники з «Замовників» ліній і з діючими ставками; рядок відкриває екран «Умови клієнта».</p>
        </field>
    </record>
</odoo>
